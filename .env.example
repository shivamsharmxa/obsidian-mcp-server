# ─── Obsidian MCP Server Configuration ───────────────────────────────────────
#
# Copy this file to .env and fill in your vault path.
# You can also pass --vault /path/to/vault on the command line,
# or set OBSIDIAN_VAULT_PATH as a system environment variable.
#
# Priority order (highest wins):
#   1. CLI arg: --vault /path/to/vault
#   2. System env var: OBSIDIAN_VAULT_PATH
#   3. This .env file
#   4. Default: ~/Documents/Obsidian/MyVault

# Path to your Obsidian vault directory
OBSIDIAN_VAULT_PATH=/Users/shivamsharma/Documents/Obsidian Vault

# ─── Examples ─────────────────────────────────────────────────────────────────
# macOS:  OBSIDIAN_VAULT_PATH=/Users/yourname/Documents/Obsidian/MyVault
# Linux:  OBSIDIAN_VAULT_PATH=/home/yourname/Obsidian/MyVault
# Windows (use forward slashes or double backslashes):
#         OBSIDIAN_VAULT_PATH=C:/Users/yourname/Documents/Obsidian/MyVault
